# Duplicate this file as .env and replace every example value.
DOCKERHUB_USERNAME=benjamingoycolea
IMAGE_TAG=latest

DB_NAME=sigaipt
DB_USERNAME=sigaipt
DB_PASSWORD=replace-with-a-long-unique-password

# These must match the public Keycloak realm and the frontend client configuration.
KEYCLOAK_ISSUER_URI=https://auth.example.edu/realms/siga-ipt
KEYCLOAK_JWK_SET_URI=https://auth.example.edu/realms/siga-ipt/protocol/openid-connect/certs
VITE_KEYCLOAK_URL=https://auth.example.edu
VITE_KEYCLOAK_REALM=siga-ipt
VITE_KEYCLOAK_CLIENT_ID=siga-ipt-web
